# ─── gonka-agent configuration ───────────────────────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ─── Wallet (required for DAPI signing) ──────────────────────────────────────
# DAPI nodes require Cosmos transaction signing — NOT Bearer tokens.
# The opengnk proxy handles signing; set your private key here.

GONKA_PRIVATE_KEY=YOUR_HEX_PRIVATE_KEY_HERE
# GONKA_ADDRESS=gonka1...   # optional — derived from key if omitted

# ─── API Keys (optional, for key pool rotation) ─────────────────────────────

# When using opengnk proxy, set to any non-empty string.
GONKA_API_KEY=unused

# Additional keys for parallel planning (comma-separated, no spaces).
# GONKA_API_KEYS=key1,key2

# ─── Inference endpoint ──────────────────────────────────────────────────────

# Points to the opengnk signing proxy.
# If running via docker-compose: http://opengnk:8090/v1 (automatic).
# If running locally: start opengnk on :8090 first, then:
GONKA_SOURCE_URL=http://localhost:8090/v1

# DAPI discovery URL (used by opengnk, not the agent directly).
# Default: http://node2.gonka.ai:8000
# GONKA_DAPI_SOURCE=http://node2.gonka.ai:8000

# ─── Models ──────────────────────────────────────────────────────────────────

# Model for the execute phase (requires strong reasoning).
AGENT_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507-FP8

# Optional: smaller/faster model for planning roles (ContextKeeper, GitWorker, etc.)
# If not set, AGENT_MODEL is used for both phases.
# A 7B-14B model here cuts planning time by 3-5x.
# AGENT_PLAN_MODEL=Qwen/Qwen2.5-14B-Instruct

# ─── Workspace ───────────────────────────────────────────────────────────────

# Directory the agent will read/modify. Defaults to the current directory.
# The agent will not access files outside this directory.
# AGENT_WORKSPACE=/path/to/your/project

# ─── Shell & safety ──────────────────────────────────────────────────────────

AGENT_SHELL=/bin/bash

# Allow run_command tool (shell execution). Set to false for read-only mode.
AGENT_ALLOW_SHELL=true

# Timeout for shell commands (e.g. build, tests).
AGENT_COMMAND_TIMEOUT=60s

# ─── Web search (optional) ───────────────────────────────────────────────────

# Brave Search API key for the web_search tool.
# Get one at: https://api.search.brave.com/
# AGENT_WEB_SEARCH_KEY=YOUR_BRAVE_KEY

# ─── Embeddings (for semantic search + semantic cache) ───────────────────────

# Gonka inference nodes serve /v1/chat/completions only.
# For semantic search and semcache, start the local embed sidecar:
#   python3 scripts/embed-server.py
# Then set:
# AGENT_EMBED_URL=http://localhost:8001/v1
# AGENT_EMBED_MODEL=all-MiniLM-L6-v2

# ─── Semantic cache ───────────────────────────────────────────────────────────

# Maximum number of task solutions to keep in local semcache (default 1000).
# SEMCACHE_MAX_ENTRIES=1000

# ─── Binary Singularity — PatternSlot store + raw input ───────────────────────

# Directory for binary slot store (pattern_slots.bin).
# Default: ~/.gonka-cache/slots
# BS_SLOT_DIR=/home/user/.gonka-cache/slots

# Raw binary input: path to ANY file to feed into the binarizer.
# The file is transmitted as-is to the embedder — zero pre-processing.
# Sources: git logs, developer sessions, downloaded specs, custom markup, anything.
# The agent reads this at startup, splits by lines, embeds each chunk,
# and distills PatternSlots that are stored in BS_SLOT_DIR.
#
# Examples:
#   BS_RAW_INPUT=/home/user/Документы/text
#   BS_RAW_INPUT=/home/user/repos/project/.git/logs/HEAD
#   BS_RAW_INPUT=/tmp/downloaded_spec.md
# BS_RAW_INPUT=

# Lines per chunk when splitting raw input for embedding (default 50).
# BS_CHUNK_LINES=50

# Minimum cosine similarity (0-10000 basis points) for a slot to match.
# 7500 = 0.75 cosine. Higher = less noise. Lower = broader recall.
# BS_MIN_SIM_BPS=7500

# Embedder URL for slot distillation (default: AGENT_EMBED_URL or localhost:8686).
# BS_EMBED_URL=http://localhost:8686

# Quality middleware URL for mesh pool search (default: localhost:9090).
# BS_QUALITY_URL=http://localhost:9090

# Distillation mode: continuous (live traffic) | ingest (one-shot) | both
# BS_DISTILL_MODE=continuous

# ─── Multi-Provider Inference ─────────────────────────────────────────────────

# OpenRouter: fast tool calls, 300+ models, free tier available.
# Register at https://openrouter.ai — free API key, no payment needed.
# OPENROUTER_API_KEY=sk-or-v1-your-key-here
# OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Gonka DAPI: main reasoning via opengnk proxy (set up above).
# GONKA_API_URL=http://localhost:8090/v1
# GONKA_MODEL=Qwen/Qwen3-235B-A22B-Instruct-2507-FP8

# Ollama: local fallback (install: curl -fsSL https://ollama.com/install.sh | sh)
# OLLAMA_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5-coder:7b

# Custom providers (up to 9, tried in order after the above):
# INFER_PROVIDER_1_TYPE=openai-compat
# INFER_PROVIDER_1_URL=http://localhost:1234/v1
# INFER_PROVIDER_1_KEY=lm-studio
# INFER_PROVIDER_1_MODEL=local-model

# ─── SearXNG (self-hosted web search) ────────────────────────────────────────

# SearXNG is auto-started via Docker if not running.
# Override URL if running externally:
# SEARXNG_URL=http://localhost:8888

# ─── MCP server (for Cursor / Claude Desktop integration) ────────────────────

AGENT_MCP_TRANSPORT=stdio
AGENT_MCP_PORT=3000
